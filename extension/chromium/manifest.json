{
  "manifest_version": 3,
  "name": "Distraction Blocker",
  "version": "1.7.0",
  "key": "",
  "description": "Enforces URL-level rules authored by the Distraction Blocker root service.",
  "minimum_chrome_version": "121.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "declarativeNetRequest",
    "alarms",
    "webRequest",
    "tabs",
    "idle"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Distraction Blocker",
    "default_popup": "status.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
