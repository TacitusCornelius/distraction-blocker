{
  "comment": "Golden fixtures shared by every browser adapter. Each case names a policy, a URL, and the exact verdict the core must return. When service schema or matching semantics change, update fixtures here first; both adapters must pass identically.",
  "policies": {
    "mixed": [
      { "id": "path-rule", "enabled": true,
        "targets": [{ "kind": "url_path", "value": "example.com/feed" }] },
      { "id": "wild-rule", "enabled": true,
        "targets": [{ "kind": "url_wildcard", "value": "example.com/vid/*" }] },
      { "id": "word-rule", "enabled": true,
        "targets": [{ "kind": "url_keyword", "value": "casino" }] },
      { "id": "yt-video", "enabled": true,
        "targets": [{ "kind": "youtube_video", "value": "dQw4w9WgXcQ" }] },
      { "id": "yt-channel", "enabled": true,
        "targets": [{ "kind": "youtube_channel", "value": "@examplehandle" }] }
    ],
    "disabled": [
      { "id": "off", "enabled": false,
        "targets": [{ "kind": "url_path", "value": "example.com/off" }] }
    ],
    "empty": []
  },
  "cases": [
    { "policy": "mixed", "url": "https://example.com/feed",
      "expect": { "rule_id": "path-rule" } },
    { "policy": "mixed", "url": "https://EXAMPLE.com/feed",
      "expect": { "rule_id": "path-rule" } },
    { "policy": "mixed", "url": "https://example.com/feed/extra", "expect": null },
    { "policy": "mixed", "url": "https://example.com/feeds", "expect": null },
    { "policy": "mixed", "url": "https://example.com/vid/98765432",
      "expect": { "rule_id": "wild-rule" } },
    { "policy": "mixed", "url": "https://example.org/vid/x", "expect": null },
    { "policy": "mixed",
      "url": "https://search.example.net/q?click=casino+bonus",
      "expect": { "rule_id": "word-rule" } },
    { "policy": "disabled", "url": "https://example.com/off", "expect": null },
    { "policy": "empty", "url": "https://example.com/feed", "expect": null },
    { "policy": "mixed", "not-a-url": true, "url": "garbage input", "expect": null },
    { "policy": "mixed", "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ&t=1s",
      "expect": { "rule_id": "yt-video" } },
    { "policy": "mixed", "url": "https://youtube.com/shorts/dQw4w9WgXcQ",
      "expect": { "rule_id": "yt-video" } },
    { "policy": "mixed",
      "url": "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ",
      "expect": { "rule_id": "yt-video" } },
    { "policy": "mixed", "url": "https://youtube.com/watch?v=aaaaaaaaaaa",
      "expect": null },
    { "policy": "mixed", "url": "https://youtube.com/@ExampleHandle/videos",
      "expect": { "rule_id": "yt-channel" } },
    { "policy": "mixed", "url": "https://youtube.com/@otherhandle",
      "expect": null },
    { "policy": "mixed", "url": "https://evil.example.net/watch?v=dQw4w9WgXcQ",
      "expect": null }
  ]
}
