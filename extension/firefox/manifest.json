{
  "manifest_version": 3,
  "name": "Distraction Blocker",
  "version": "1.3.0",
  "description": "Enforces URL-level rules authored by the Distraction Blocker root service.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{e4f1a2b3-9c8d-4e5f-a6b7-8c9d0e1f2a3b}",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["core/engine.js", "background.js"],
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Distraction Blocker",
    "default_popup": "status.html"
  }
}
